# Copiar a .env (no se sube al repositorio)
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria
SITIO_URL=https://kallpa-software.duckdns.org
CORS_ORIGENES=https://kallpa-software.duckdns.org

# Primer usuario del panel /panel (solo se crea si no hay ninguno)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=equipo@example.com
ADMIN_PASSWORD=

# Agente IA: Ollama de la instancia IS (vacío = solo base de conocimiento)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Correo saliente (Gmail: activar verificación en dos pasos y crear una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
CORREO_EQUIPO=

# WhatsApp Cloud API (Meta). Valores solo en el .env del servidor, nunca en el repositorio.
# Webhook en Meta: https://<dominio>/api/whatsapp/webhook (campo «messages»)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_APP_SECRET=
